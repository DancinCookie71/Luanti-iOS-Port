+#if !TARGET_OS_TV
+/* UIScene life cycle adoption is mandatory on modern iOS (iOS 26+ logs a
+ * warning, iOS 27 traps if the app does not adopt it). SDL2 does not support
+ * scenes upstream, so we add a minimal scene delegate here, modeled on the
+ * SDL3 implementation. */
+@interface SDLUIKitSceneDelegate : UIResponder <UIWindowSceneDelegate>
+@end
+
+@implementation SDLUIKitSceneDelegate
+
++ (NSString *)getSceneDelegateClassName
+{
+    return @"SDLUIKitSceneDelegate";
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) {
+        return;
+    }
+    UIWindowScene *windowScene = (UIWindowScene *)scene;
+    windowScene.delegate = self;
+}
+
+/* Keep the SDL window(s) filling the scene when the coordinate space changes
+ * (e.g. device rotation). Without this the window can stay at its initial
+ * size and only cover part of the screen. */
+- (void)windowScene:(UIWindowScene *)windowScene
+    didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace
+    interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation
+    traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    for (UIWindow *window in [UIApplication sharedApplication].windows) {
+        if (window.windowScene == windowScene) {
+            window.frame = windowScene.coordinateSpace.bounds;
+        }
+    }
+}
 
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{ /* nothing; UIApplicationDelegate callbacks still fire */ }
+
+- (void)sceneWillResignActive:(UIScene *)scene
+{ /* nothing */ }
+
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{ /* nothing */ }
+
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{ /* nothing */ }
+
 @end
+#endif /* !TARGET_OS_TV */
 
