+// Password vault
+
+static PasswordVault &pwvault()
+{
+	return PasswordVault::get();
+}
+
+int ModApiMainMenu::l_pwvault_status(lua_State *L)
+{
+	switch (pwvault().status()) {
+	case PasswordVault::Status::Unlocked: lua_pushliteral(L, "unlocked"); break;
+	case PasswordVault::Status::Locked:   lua_pushliteral(L, "locked"); break;
+	case PasswordVault::Status::None:     lua_pushliteral(L, "none"); break;
+	}
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_set_master(lua_State *L)
+{
+	const char *master = luaL_checkstring(L, 1);
+	lua_pushboolean(L, pwvault().setMasterPassword(master));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_change_master(lua_State *L)
+{
+	const char *old_master = luaL_checkstring(L, 1);
+	const char *new_master = luaL_checkstring(L, 2);
+	lua_pushboolean(L, pwvault().changeMasterPassword(old_master, new_master));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_remove_master(lua_State *L)
+{
+	const char *master = luaL_checkstring(L, 1);
+	lua_pushboolean(L, pwvault().removeMasterPassword(master));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_unlock(lua_State *L)
+{
+	const char *master = luaL_checkstring(L, 1);
+	lua_pushboolean(L, pwvault().unlock(master));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_lock(lua_State *L)
+{
+	pwvault().lock();
+	return 0;
+}
+
+int ModApiMainMenu::l_pwvault_get(lua_State *L)
+{
+	const char *host = luaL_checkstring(L, 1);
+	int port = (int)luaL_checkinteger(L, 2);
+	auto password = pwvault().getPassword(host, port);
+	if (password) {
+		lua_pushlstring(L, password->c_str(), password->size());
+	} else {
+		lua_pushnil(L);
+	}
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_put(lua_State *L)
+{
+	const char *host = luaL_checkstring(L, 1);
+	int port = (int)luaL_checkinteger(L, 2);
+	const char *password = luaL_checkstring(L, 3);
+	lua_pushboolean(L, pwvault().setPassword(host, port, password));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_remove(lua_State *L)
+{
+	const char *host = luaL_checkstring(L, 1);
+	int port = (int)luaL_checkinteger(L, 2);
+	lua_pushboolean(L, pwvault().removePassword(host, port));
+	return 1;
+}
+
+int ModApiMainMenu::l_pwvault_list(lua_State *L)
+{
+	auto entries = pwvault().listEntries();
+	lua_createtable(L, entries.size(), 0);
+	int i = 1;
+	for (const auto &[host, port] : entries) {
+		lua_createtable(L, 0, 2);
+		lua_pushstring(L, host.c_str());
+		lua_setfield(L, -2, "host");
+		lua_pushinteger(L, port);
+		lua_setfield(L, -2, "port");
+		lua_rawseti(L, -2, i++);
+	}
+	return 1;
+}
+
