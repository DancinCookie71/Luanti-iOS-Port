diff --git a/src/client/password_vault.cpp b/src/client/password_vault.cpp
new file mode 100644
index 0000000..c226db3
--- /dev/null
+++ b/src/client/password_vault.cpp
@@ -0,0 +1,460 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "password_vault.h"
+#include "config.h"
+#include "filesys.h"
+#include "log.h"
+#include "porting.h"
+
+#if USE_OPENSSL
+#include <openssl/evp.h>
+#include <openssl/hmac.h>
+#include <openssl/rand.h>
+#endif
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+namespace {
+
+constexpr int KDF_ITERATIONS = 200000;
+constexpr int SALT_LEN = 16;
+constexpr int KEY_LEN = 32;
+constexpr int NONCE_LEN = 12;
+constexpr int TAG_LEN = 16;
+constexpr const char *FILE_MAGIC = "LuantiPW1";
+
+std::string entryKey(const std::string &host, int port)
+{
+	return host + "\x1f" + std::to_string(port);
+}
+
+std::string entryKeyFor(const std::string &host, const std::string &port)
+{
+	return host + "\x1f" + port;
+}
+
+const char HEX[] = "0123456789abcdef";
+
+std::string toHex(const std::string &s)
+{
+	std::string out;
+	out.reserve(s.size() * 2);
+	for (unsigned char c : s) {
+		out += HEX[c >> 4];
+		out += HEX[c & 0xF];
+	}
+	return out;
+}
+
+bool fromHex(const std::string &s, std::string &out)
+{
+	if (s.size() % 2)
+		return false;
+	out.clear();
+	out.reserve(s.size() / 2);
+	auto nib = [](char c) -> int {
+		if (c >= '0' && c <= '9') return c - '0';
+		if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+		if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+		return -1;
+	};
+	for (size_t i = 0; i < s.size(); i += 2) {
+		int hi = nib(s[i]);
+		int lo = nib(s[i + 1]);
+		if (hi < 0 || lo < 0)
+			return false;
+		out += (char)((hi << 4) | lo);
+	}
+	return true;
+}
+
+std::string entriesToPlaintext(const std::map<std::string, std::string> &entries)
+{
+	std::string out = std::to_string(entries.size()) + "\n";
+	for (const auto &[key, password] : entries) {
+		// key is "host\x1fport"; split it back out.
+		auto sep = key.find('\x1f');
+		std::string host = key.substr(0, sep);
+		std::string port = key.substr(sep + 1);
+		out += toHex(host) + " " + port + " " + toHex(password) + "\n";
+	}
+	return out;
+}
+
+bool plaintextToEntries(const std::string &plaintext,
+		std::map<std::string, std::string> &entries)
+{
+	std::istringstream in(plaintext);
+	std::string line;
+	if (!std::getline(in, line))
+		return false;
+	char *end = nullptr;
+	long count = std::strtol(line.c_str(), &end, 10);
+	if (end == line.c_str() || count < 0)
+		return false;
+	entries.clear();
+	for (long i = 0; i < count; ++i) {
+		if (!std::getline(in, line))
+			return false;
+		std::istringstream ls(line);
+		std::string host_hex, port, password_hex;
+		if (!(ls >> host_hex >> port >> password_hex))
+			return false;
+		std::string host, password;
+		if (!fromHex(host_hex, host) || !fromHex(password_hex, password))
+			return false;
+		entries[entryKeyFor(host, port)] = password;
+	}
+	return true;
+}
+
+} // namespace
+
+// Re-exposed so the helper above can build entry keys.
+PasswordVault::PasswordVault()
+{
+	m_path = porting::path_user + DIR_DELIM + "password_vault";
+#if USE_OPENSSL
+	load();
+#endif
+}
+
+PasswordVault &PasswordVault::get()
+{
+	static PasswordVault vault;
+	return vault;
+}
+
+PasswordVault::Status PasswordVault::status() const
+{
+	if (!m_has_master)
+		return Status::None;
+	return m_unlocked ? Status::Unlocked : Status::Locked;
+}
+
+bool PasswordVault::deriveKey(const std::string &master, std::string &key_out) const
+{
+#if USE_OPENSSL
+	if (m_salt.empty())
+		return false;
+	key_out.assign(KEY_LEN, '\0');
+	return PKCS5_PBKDF2_HMAC(master.c_str(), (int)master.size(),
+			(const unsigned char *)m_salt.data(), (int)m_salt.size(),
+			m_iterations, EVP_sha256(), KEY_LEN,
+			(unsigned char *)key_out.data()) == 1;
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::load()
+{
+#if USE_OPENSSL
+	std::ifstream in(m_path, std::ios::binary);
+	if (!in)
+		return true; // no vault yet
+
+	std::string magic, salt_hex, iter_str, verifier_hex, blob_hex;
+	if (!std::getline(in, magic) || magic != FILE_MAGIC)
+		return true;
+	if (!std::getline(in, salt_hex) || !fromHex(salt_hex, m_salt))
+		return true;
+	if (!std::getline(in, iter_str))
+		return true;
+	m_iterations = std::atoi(iter_str.c_str());
+	if (m_iterations < 1)
+		return true;
+	if (!std::getline(in, verifier_hex) || !fromHex(verifier_hex, m_verifier))
+		return true;
+	if (!std::getline(in, blob_hex) || !fromHex(blob_hex, m_blob))
+		return true;
+
+	m_has_master = true;
+	return true;
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::save() const
+{
+#if USE_OPENSSL
+	std::string content = std::string(FILE_MAGIC) + "\n" + toHex(m_salt) + "\n" +
+			std::to_string(m_iterations) + "\n" + toHex(m_verifier) + "\n" +
+			toHex(m_blob) + "\n";
+	std::ofstream out(m_path, std::ios::binary | std::ios::trunc);
+	if (!out)
+		return false;
+	out << content;
+	return out.good();
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::setMasterPassword(const std::string &master)
+{
+#if USE_OPENSSL
+	if (m_has_master || master.empty())
+		return false;
+
+	m_salt.assign(SALT_LEN, '\0');
+	if (RAND_bytes((unsigned char *)m_salt.data(), SALT_LEN) != 1)
+		return false;
+	m_iterations = KDF_ITERATIONS;
+
+	if (!deriveKey(master, m_key))
+		return false;
+
+	// Verifier = HMAC-SHA256(key, magic), truncated.
+	unsigned char ver[EVP_MAX_MD_SIZE];
+	unsigned int verlen = 0;
+	if (!HMAC(EVP_sha256(), m_key.data(), m_key.size(),
+			(const unsigned char *)FILE_MAGIC, sizeof(FILE_MAGIC) - 1, ver, &verlen))
+		return false;
+	m_verifier.assign((const char *)ver, 16);
+
+	m_entries.clear();
+	m_has_master = true;
+	m_unlocked = true;
+
+	if (!encryptEntries() || !save())
+		return false;
+	return true;
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::changeMasterPassword(const std::string &old_master,
+		const std::string &new_master)
+{
+#if USE_OPENSSL
+	if (!m_has_master || new_master.empty())
+		return false;
+	if (m_unlocked) {
+		// We already have the key; re-derive from the new password.
+		std::string new_key;
+		std::string salt = m_salt;
+		// Keep the same salt; derive the new key from the new password.
+		m_salt.assign(SALT_LEN, '\0');
+		if (RAND_bytes((unsigned char *)m_salt.data(), SALT_LEN) != 1)
+			return false;
+		if (!deriveKey(new_master, new_key))
+			return false;
+		m_key = new_key;
+		unsigned char ver[EVP_MAX_MD_SIZE];
+		unsigned int verlen = 0;
+		if (!HMAC(EVP_sha256(), m_key.data(), m_key.size(),
+				(const unsigned char *)FILE_MAGIC, sizeof(FILE_MAGIC) - 1, ver, &verlen))
+			return false;
+		m_verifier.assign((const char *)ver, 16);
+		return encryptEntries() && save();
+	} else {
+		if (!unlock(old_master))
+			return false;
+		// Re-encrypt with the new key (same entries).
+		std::string new_key;
+		m_salt.assign(SALT_LEN, '\0');
+		if (RAND_bytes((unsigned char *)m_salt.data(), SALT_LEN) != 1)
+			return false;
+		if (!deriveKey(new_master, new_key))
+			return false;
+		m_key = new_key;
+		unsigned char ver[EVP_MAX_MD_SIZE];
+		unsigned int verlen = 0;
+		if (!HMAC(EVP_sha256(), m_key.data(), m_key.size(),
+				(const unsigned char *)FILE_MAGIC, sizeof(FILE_MAGIC) - 1, ver, &verlen))
+			return false;
+		m_verifier.assign((const char *)ver, 16);
+		return encryptEntries() && save();
+	}
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::removeMasterPassword(const std::string &master)
+{
+#if USE_OPENSSL
+	if (!m_has_master)
+		return false;
+	if (!m_unlocked && !unlock(master))
+		return false;
+	m_has_master = false;
+	m_unlocked = false;
+	m_entries.clear();
+	m_salt.clear();
+	m_verifier.clear();
+	m_blob.clear();
+	m_key.clear();
+	// Remove the file if it exists.
+	fs::DeleteSingleFileOrEmptyDirectory(m_path, true);
+	return true;
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::unlock(const std::string &master)
+{
+#if USE_OPENSSL
+	if (!m_has_master)
+		return false;
+	std::string key;
+	if (!deriveKey(master, key))
+		return false;
+	unsigned char ver[EVP_MAX_MD_SIZE];
+	unsigned int verlen = 0;
+	if (!HMAC(EVP_sha256(), key.data(), key.size(),
+			(const unsigned char *)FILE_MAGIC, sizeof(FILE_MAGIC) - 1, ver, &verlen))
+		return false;
+	if (m_verifier.size() != 16 ||
+			!std::equal(m_verifier.begin(), m_verifier.end(), ver))
+		return false;
+	m_key = key;
+	if (!decryptEntries()) {
+		m_key.clear();
+		return false;
+	}
+	m_unlocked = true;
+	return true;
+#else
+	return false;
+#endif
+}
+
+void PasswordVault::lock()
+{
+	m_unlocked = false;
+	m_key.clear();
+	m_entries.clear();
+}
+
+std::optional<std::string> PasswordVault::getPassword(const std::string &host, int port) const
+{
+	if (!m_unlocked)
+		return std::nullopt;
+	auto it = m_entries.find(entryKey(host, port));
+	if (it == m_entries.end())
+		return std::nullopt;
+	return it->second;
+}
+
+bool PasswordVault::setPassword(const std::string &host, int port, const std::string &password)
+{
+#if USE_OPENSSL
+	if (!m_unlocked)
+		return false;
+	m_entries[entryKey(host, port)] = password;
+	return encryptEntries() && save();
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::removePassword(const std::string &host, int port)
+{
+#if USE_OPENSSL
+	if (!m_unlocked)
+		return false;
+	auto it = m_entries.find(entryKey(host, port));
+	if (it == m_entries.end())
+		return false;
+	m_entries.erase(it);
+	return encryptEntries() && save();
+#else
+	return false;
+#endif
+}
+
+std::vector<std::pair<std::string, int>> PasswordVault::listEntries() const
+{
+	std::vector<std::pair<std::string, int>> out;
+	if (!m_unlocked)
+		return out;
+	for (const auto &[key, _] : m_entries) {
+		auto sep = key.find('\x1f');
+		if (sep == std::string::npos)
+			continue;
+		out.emplace_back(key.substr(0, sep), std::atoi(key.substr(sep + 1).c_str()));
+	}
+	std::sort(out.begin(), out.end());
+	return out;
+}
+
+// AES-256-GCM encryption of the current entries into m_blob.
+bool PasswordVault::encryptEntries()
+{
+#if USE_OPENSSL
+	std::string plaintext = entriesToPlaintext(m_entries);
+	std::string nonce(NONCE_LEN, '\0');
+	if (RAND_bytes((unsigned char *)nonce.data(), NONCE_LEN) != 1)
+		return false;
+
+	std::string cipher(plaintext.size(), '\0');
+	std::string tag(TAG_LEN, '\0');
+
+	EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+	if (!ctx)
+		return false;
+	int outlen = 0, finlen = 0;
+	bool ok = false;
+	if (EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) == 1 &&
+			EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, NONCE_LEN, NULL) == 1 &&
+			EVP_EncryptInit_ex(ctx, NULL, NULL, (const unsigned char *)m_key.data(),
+					(const unsigned char *)nonce.data()) == 1 &&
+			EVP_EncryptUpdate(ctx, (unsigned char *)cipher.data(), &outlen,
+					(const unsigned char *)plaintext.data(), (int)plaintext.size()) == 1 &&
+			EVP_EncryptFinal_ex(ctx, (unsigned char *)cipher.data() + outlen, &finlen) == 1 &&
+			EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, TAG_LEN, tag.data()) == 1)
+		ok = true;
+	EVP_CIPHER_CTX_free(ctx);
+	if (!ok)
+		return false;
+
+	m_blob = nonce + tag + cipher;
+	return true;
+#else
+	return false;
+#endif
+}
+
+bool PasswordVault::decryptEntries()
+{
+#if USE_OPENSSL
+	if (m_blob.size() < NONCE_LEN + TAG_LEN)
+		return false;
+	std::string nonce = m_blob.substr(0, NONCE_LEN);
+	std::string tag = m_blob.substr(NONCE_LEN, TAG_LEN);
+	std::string cipher = m_blob.substr(NONCE_LEN + TAG_LEN);
+
+	std::string plaintext(cipher.size(), '\0');
+	EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+	if (!ctx)
+		return false;
+	int outlen = 0, finlen = 0;
+	bool ok = false;
+	if (EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) == 1 &&
+			EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, NONCE_LEN, NULL) == 1 &&
+			EVP_DecryptInit_ex(ctx, NULL, NULL, (const unsigned char *)m_key.data(),
+					(const unsigned char *)nonce.data()) == 1 &&
+			EVP_DecryptUpdate(ctx, (unsigned char *)plaintext.data(), &outlen,
+					(const unsigned char *)cipher.data(), (int)cipher.size()) == 1 &&
+			EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, TAG_LEN, (void *)tag.data()) == 1 &&
+			EVP_DecryptFinal_ex(ctx, (unsigned char *)plaintext.data() + outlen, &finlen) == 1)
+		ok = true;
+	EVP_CIPHER_CTX_free(ctx);
+	if (!ok)
+		return false;
+	plaintext.resize(outlen + finlen);
+	return plaintextToEntries(plaintext, m_entries);
+#else
+	return false;
+#endif
+}
diff --git a/src/client/password_vault.h b/src/client/password_vault.h
new file mode 100644
index 0000000..a32217f
--- /dev/null
+++ b/src/client/password_vault.h
@@ -0,0 +1,67 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// Client-side password vault for server logins.
+//
+// Stores per-server passwords encrypted at rest behind a single master
+// password (PBKDF2 key derivation + AES-256-GCM). The derived key is held in
+// memory only while unlocked.
+//
+// This is a convenience store, not a hardened password manager: it protects
+// against casual reading of the user's files on a shared/unlocked device, but
+// not against a compromised device or a malicious process.
+
+#pragma once
+
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+class PasswordVault
+{
+public:
+	static PasswordVault &get();
+
+	enum class Status { None, Locked, Unlocked };
+
+	Status status() const;
+
+	// Master password management.
+	bool setMasterPassword(const std::string &master);
+	bool changeMasterPassword(const std::string &old_master,
+			const std::string &new_master);
+	bool removeMasterPassword(const std::string &master);
+	bool unlock(const std::string &master);
+	void lock();
+
+	// Entry access (requires the vault to be unlocked).
+	std::optional<std::string> getPassword(const std::string &host, int port) const;
+	bool setPassword(const std::string &host, int port, const std::string &password);
+	bool removePassword(const std::string &host, int port);
+	std::vector<std::pair<std::string, int>> listEntries() const;
+
+private:
+	PasswordVault();
+
+	bool load();
+	bool save() const;
+	bool deriveKey(const std::string &master, std::string &key_out) const;
+	bool encryptEntries();
+	bool decryptEntries();
+
+	// Decrypted entries: "host\x1fport" -> password.
+	std::map<std::string, std::string> m_entries;
+
+	// Persistent metadata.
+	std::string m_salt;
+	int m_iterations = 0;
+	std::string m_verifier;
+	std::string m_blob; // encrypted entries (nonce||tag||cipher)
+
+	bool m_has_master = false;
+	bool m_unlocked = false;
+	std::string m_key; // 32 bytes, only valid while unlocked
+
+	std::string m_path;
+};
