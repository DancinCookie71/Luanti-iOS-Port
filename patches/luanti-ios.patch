new file mode 100644
index 0000000..6dbaac5
--- /dev/null
+++ b/src/porting_ios.h
@@ -0,0 +1,43 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// iOS equivalents of the Android native input dialogs.
+
+#pragma once
+
+#ifndef __IPHONEOS__
+#error This header has to be included on the iOS port only!
+#endif
+
+#include "irrlichttypes_bloated.h"
+#include <string>
+
+namespace porting {
+
+/**
+ * Show a text input dialog (a box above the keyboard)
+ * @param hint Hint to be shown
+ * @param current Initial value to be displayed
+ * @param editType Type of the text field
+ * (1 = multi-line text input; 2 = single-line text input; 3 = password field)
+ */
+void showTextInputDialog(const std::string &hint, const std::string &current, int editType);
+
+/**
+ * Show a selection dialog
+ */
+void showComboBoxDialog(const std::string *optionList, s32 listSize, s32 selectedIdx);
+
+enum AndroidDialogType { TEXT_INPUT, SELECTION_INPUT };
+
+AndroidDialogType getLastInputDialogType();
+
+enum AndroidDialogState { DIALOG_SHOWN, DIALOG_INPUTTED, DIALOG_CANCELED };
+
+AndroidDialogState getInputDialogState();
+
+std::string getInputDialogMessage();
+
+int getInputDialogSelection();
+
+// Shared with the Android port: true if the platform has a native input dialog.
+} // namespace porting
diff --git a/src/porting_ios.mm b/src/porting_ios.mm
new file mode 100644
index 0000000..251fdfb
--- /dev/null
+++ b/src/porting_ios.mm
@@ -0,0 +1,124 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// iOS platform helpers. This file is Objective-C++ on purpose.
+
+#include "porting_ios.h"
+
+#include <Foundation/Foundation.h>
+#include <UIKit/UIKit.h>
+#include <string>
+
+extern "C" const char *luanti_ios_get_documents_path(void)
+{
+	NSArray *paths = NSSearchPathForDirectoriesInDomains(
+			NSDocumentDirectory, NSUserDomainMask, YES);
+	if (!paths || [paths count] == 0)
+		return nullptr;
+	static std::string result;
+	result = [[paths objectAtIndex:0] UTF8String];
+	return result.c_str();
+}
+
+extern "C" const char *luanti_ios_get_bundle_path(void)
+{
+	static std::string result;
+	result = [[[NSBundle mainBundle] bundlePath] UTF8String];
+	return result.c_str();
+}
+
+namespace porting {
+
+static AndroidDialogState s_dialog_state = DIALOG_CANCELED;
+static AndroidDialogType s_dialog_type = TEXT_INPUT;
+static std::string s_dialog_message;
+static int s_dialog_selection = -1;
+
+void showTextInputDialog(const std::string &hint, const std::string &current, int editType)
+{
+	s_dialog_type = TEXT_INPUT;
+	s_dialog_state = DIALOG_SHOWN;
+	s_dialog_message.clear();
+	s_dialog_selection = -1;
+
+	@autoreleasepool {
+		UIAlertController *alert = [UIAlertController
+				alertControllerWithTitle:nil
+				message:(hint.empty() ? nil : @(hint.c_str()))
+				preferredStyle:UIAlertControllerStyleAlert];
+
+		[alert addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+			tf.text = @(current.c_str());
+			tf.secureTextEntry = (editType == 3);
+			tf.autocapitalizationType = UITextAutocapitalizationTypeNone;
+			tf.autocorrectionType = UITextAutocorrectionTypeNo;
+		}];
+
+		[alert addAction:[UIAlertAction actionWithTitle:@"OK"
+				style:UIAlertActionStyleDefault
+				handler:^(UIAlertAction *action) {
+			UITextField *tf = alert.textFields.firstObject;
+			s_dialog_message = tf.text ? tf.text.UTF8String : "";
+			s_dialog_state = DIALOG_INPUTTED;
+		}]];
+
+		[alert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+				style:UIAlertActionStyleCancel
+				handler:^(UIAlertAction *action) {
+			s_dialog_state = DIALOG_CANCELED;
+		}]];
+
+		UIWindow *keyWindow = nil;
+		for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+			if (![scene isKindOfClass:[UIWindowScene class]])
+				continue;
+			for (UIWindow *w in ((UIWindowScene *)scene).windows) {
+				if (w.isKeyWindow) {
+					keyWindow = w;
+					break;
+				}
+			}
+		}
+		UIViewController *root = keyWindow.rootViewController;
+		if (root)
+			[root presentViewController:alert animated:YES completion:nil];
+		else
+			s_dialog_state = DIALOG_CANCELED;
+	}
+}
+
+void showComboBoxDialog(const std::string *optionList, s32 listSize, s32 selectedIdx)
+{
+	// Not implemented on iOS; the Irrlicht dropdown is used instead.
+	(void)optionList;
+	(void)listSize;
+	(void)selectedIdx;
+	s_dialog_state = DIALOG_CANCELED;
+}
+
+AndroidDialogType getLastInputDialogType()
+{
+	return s_dialog_type;
+}
+
+AndroidDialogState getInputDialogState()
+{
+	return s_dialog_state;
+}
+
+std::string getInputDialogMessage()
+{
+	std::string msg = s_dialog_message;
+	s_dialog_message.clear();
+	s_dialog_state = DIALOG_CANCELED;
+	return msg;
+}
+
+int getInputDialogSelection()
+{
+	int sel = s_dialog_selection;
+	s_dialog_selection = -1;
+	s_dialog_state = DIALOG_CANCELED;
+	return sel;
+}
+
+} // namespace porting
