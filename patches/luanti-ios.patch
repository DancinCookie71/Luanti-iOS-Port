new file mode 100644
index 0000000..750c4a3
--- /dev/null
+++ b/util/ios/install_resources.cmake
@@ -0,0 +1,15 @@
+# Copy the runtime data files into the (flat) iOS app bundle.
+# Invoked as a POST_BUILD step from src/CMakeLists.txt.
+# Variables: TARGET_DIR (the .app directory), SOURCE_DIR (Luanti source root)
+
+execute_process(COMMAND ${CMAKE_COMMAND} -E make_directory "${TARGET_DIR}/client")
+execute_process(COMMAND ${CMAKE_COMMAND} -E make_directory "${TARGET_DIR}/textures/base")
+
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_DIR}/builtin" "${TARGET_DIR}/builtin")
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_DIR}/client/shaders" "${TARGET_DIR}/client/shaders")
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_DIR}/fonts" "${TARGET_DIR}/fonts")
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_DIR}/textures/base/pack" "${TARGET_DIR}/textures/base/pack")
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy "${SOURCE_DIR}/minetest.conf.example" "${TARGET_DIR}/minetest.conf.example")
+
+# devtest: gives us a playable game without ContentDB (curl) support
+execute_process(COMMAND ${CMAKE_COMMAND} -E copy_directory "${SOURCE_DIR}/games/devtest" "${TARGET_DIR}/games/devtest")
