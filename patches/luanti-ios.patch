+++ b/builtin/mainmenu/dlg_password_manager.lua
@@ -0,0 +1,196 @@
+-- Luanti
+-- SPDX-License-Identifier: LGPL-2.1-or-later
+-- Password vault manager: set/unlock the master password and manage the
+-- stored server passwords.
+
+local function pwvault_formspec(dialogdata)
+	local status = core.pwvault_status()
+
+	if status == "unlocked" and dialogdata.mode == "change" then
+		local retval = {
+			"formspec_version[4]",
+			"size[8.5,5.2]",
+			"label[0.5,0.5;", fgettext("Change master password"), "]",
+			"pwdfield[0.5,1.1;7.5,0.8;pw_old;", fgettext("Current password"), ";]",
+			"pwdfield[0.5,2.1;7.5,0.8;pw_new;", fgettext("New password"), ";]",
+			"pwdfield[0.5,3.1;7.5,0.8;pw_new2;", fgettext("Confirm new password"), ";]",
+		}
+		if dialogdata.error then
+			table.insert_all(retval, {
+				"label[0.5,4.0;", core.formspec_escape(dialogdata.error), "]",
+			})
+		end
+		table.insert_all(retval, {
+			"container[0.5,4.3]",
+			"button[0,0;3,0.8;btn_change_confirm;", fgettext("Change"), "]",
+			"button[5,0;3,0.8;btn_change_cancel;", fgettext("Cancel"), "]",
+			"container_end[]",
+		})
+		return table.concat(retval, "")
+	end
+
+	if status == "none" then
+		local retval = {
+			"formspec_version[4]",
+			"size[8.5,4.6]",
+			"label[0.5,0.5;", fgettext("Set a master password"), "]",
+			"label[0.5,0.9;", fgettext("Stored server passwords are encrypted with it."), "]",
+			"pwdfield[0.5,1.4;7.5,0.8;pw_master;", fgettext("Master password"), ";]",
+			"pwdfield[0.5,2.4;7.5,0.8;pw_master2;", fgettext("Confirm password"), ";]",
+		}
+		if dialogdata.error then
+			table.insert_all(retval, {
+				"label[0.5,3.2;", core.formspec_escape(dialogdata.error), "]",
+			})
+		end
+		table.insert_all(retval, {
+			"container[0.5,3.6]",
+			"button[0,0;2.5,0.8;btn_set;", fgettext("Set"), "]",
+			"button[5,0;3,0.8;btn_close;", fgettext("Cancel"), "]",
+			"container_end[]",
+		})
+		return table.concat(retval, "")
+	end
+
+	if status == "locked" then
+		local retval = {
+			"formspec_version[4]",
+			"size[8.5,3.8]",
+			"label[0.5,0.5;", fgettext("Enter your master password"), "]",
+			"pwdfield[0.5,1.1;7.5,0.8;pw_master;", fgettext("Master password"), ";]",
+		}
+		if dialogdata.error then
+			table.insert_all(retval, {
+				"label[0.5,2.0;", core.formspec_escape(dialogdata.error), "]",
+			})
+		end
+		table.insert_all(retval, {
+			"container[0.5,2.6]",
+			"button[0,0;2.5,0.8;btn_unlock;", fgettext("Unlock"), "]",
+			"button[5,0;3,0.8;btn_close;", fgettext("Cancel"), "]",
+			"container_end[]",
+		})
+		return table.concat(retval, "")
+	end
+
+	-- unlocked, normal view
+	local entries = core.pwvault_list() or {}
+	local rows = {}
+	for _, e in ipairs(entries) do
+		rows[#rows + 1] = core.formspec_escape(e.host) .. "," .. tostring(e.port)
+	end
+	local rowtext = table.concat(rows, ",")
+
+	return table.concat({
+		"formspec_version[4]",
+		"size[13,8]",
+		"label[0.5,0.5;", fgettext("Password vault (unlocked)"), "]",
+		"tablecolumns[text;text]",
+		"table[0.5,1;12,4.5;entries;", fgettext("Address"), ",", fgettext("Port"), ";",
+			rowtext, ";0]",
+		"container[0.5,5.9]",
+		"button[0,0;2.5,0.8;btn_remove;", fgettext("Remove"), "]",
+		"button[2.75,0;2.5,0.8;btn_clearall;", fgettext("Clear all"), "]",
+		"button[5.5,0;3,0.8;btn_lock;", fgettext("Lock"), "]",
+		"container_end[]",
+		"container[0.5,6.9]",
+		"button[0,0;3,0.8;btn_change;", fgettext("Change master password"), "]",
+		"button[9.5,0;3,0.8;btn_close;", fgettext("Close"), "]",
+		"container_end[]",
+	}, "")
+end
+
+local function pwvault_buttonhandler(this, fields)
+	this.data.error = nil
+	local status = core.pwvault_status()
+
+	if fields.btn_close or fields.btn_change_cancel then
+		if fields.btn_change_cancel then
+			this.data.mode = nil
+		end
+		if fields.btn_close then
+			this:delete()
+			return true
+		end
+		return true
+	end
+
+	if status == "unlocked" and this.data.mode == "change" then
+		if fields.btn_change_confirm then
+			if fields.pw_new == "" then
+				this.data.error = fgettext("Password cannot be empty")
+				return true
+			end
+			if fields.pw_new ~= fields.pw_new2 then
+				this.data.error = fgettext("Passwords do not match")
+				return true
+			end
+			if not core.pwvault_change_master(fields.pw_old, fields.pw_new) then
+				this.data.error = fgettext("Wrong current password")
+				return true
+			end
+			this.data.mode = nil
+			return true
+		end
+		return false
+	end
+
+	if status == "none" and fields.btn_set then
+		if fields.pw_master == "" then
+			this.data.error = fgettext("Password cannot be empty")
+			return true
+		end
+		if fields.pw_master ~= fields.pw_master2 then
+			this.data.error = fgettext("Passwords do not match")
+			return true
+		end
+		if not core.pwvault_set_master(fields.pw_master) then
+			this.data.error = fgettext("Failed to set master password")
+			return true
+		end
+		return true
+	end
+
+	if status == "locked" and fields.btn_unlock then
+		if not core.pwvault_unlock(fields.pw_master) then
+			this.data.error = fgettext("Wrong master password")
+			return true
+		end
+		return true
+	end
+
+	if status == "unlocked" then
+		if fields.btn_lock then
+			core.pwvault_lock()
+			return true
+		end
+		if fields.btn_change then
+			this.data.mode = "change"
+			return true
+		end
+		if fields.btn_clearall then
+			local entries = core.pwvault_list() or {}
+			for _, e in ipairs(entries) do
+				core.pwvault_remove(e.host, e.port)
+			end
+			return true
+		end
+		if fields.btn_remove then
+			local entries = core.pwvault_list() or {}
+			local idx = core.get_table_index("entries")
+			if idx and entries[idx] then
+				core.pwvault_remove(entries[idx].host, entries[idx].port)
+			end
+			return true
+		end
+	end
+
+	return false
+end
+
+function create_password_manager_dialog()
+	return dialog_create("dlg_password_manager",
+			pwvault_formspec,
+			pwvault_buttonhandler,
+			nil)
+end
